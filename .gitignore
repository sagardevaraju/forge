# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite db (libsql fallback)
forge-local.db*

# ML artifacts — heavyweight binaries, regenerate via synthesize_book.py + train.py
artifacts/*.parquet
artifacts/*.joblib
# P2.37 CV weak-label cache is small (~150 KB for 10k rows) and tracked
# because the UI and training pipeline both read it at run/render time.
!artifacts/cv_weak_labels.parquet
# Phase 2 calibration parquets (P2.10 HURDAT2, P2.3 regime) are also tracked.
!artifacts/hurdat2/*.parquet
!artifacts/regime/*.parquet

# Pre-cached Sentinel-2 chips (~6.5 GB for 10k policies). Rebuild with
# scripts/cache_s2_chips.py. Failure log + raw stdout log also regenerate.
artifacts/chips/
artifacts/chips_fetch_failures.txt
artifacts/chips_fetch.log

# P3.9 quarterly post-mortem reports — regenerated by
# `python -m scripts.postmortem` and uploaded as a GHA artifact by the
# postmortem workflow; not committed back to the repo.
artifacts/postmortem/

# AUDIT.3 Phase 1 NHC error-tabulation downloads (~7 MB each, regenerate
# with `python -m scripts.fetch_nhc_errors --refresh`). The aggregated
# climatology JSON in artifacts/nhc/*.json IS committed.
artifacts/nhc/.cache/

# AUDIT.3 Phase 3 USGS EPQS per-point response cache (gitignored — one
# small JSON per policy lat/lon, regenerated by
# `python -m scripts.extract_elevations`). The anchor table in
# artifacts/elevations/known_points.json IS committed.
artifacts/elevations/.cache/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Eval artifacts — regenerate via `python -m eval.component_metrics`
# and `python -m eval.end_to_end`.
eval/results/*.json
eval/results/*.png

# Playwright MCP traces
.playwright-mcp/

# Playwright e2e runtime artifacts (regenerate via `npm run e2e`)
/test-results/
/playwright-report/

# Root-level dev screenshots (not docs)
/*.png

# Local worktrees for isolated subagent execution
.worktrees/

# Brainstorming visual companion sessions
.superpowers/
artifacts/simulations/
