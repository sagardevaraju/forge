# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite db (libsql fallback)
forge-local.db*

# ML artifacts — heavyweight binaries, regenerate via synthesize_book.py + train.py
artifacts/*.parquet
artifacts/*.joblib

# Pre-cached Sentinel-2 chips (~6.5 GB for 10k policies). Rebuild with
# scripts/cache_s2_chips.py. Failure log + raw stdout log also regenerate.
artifacts/chips/
artifacts/chips_fetch_failures.txt
artifacts/chips_fetch.log

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Eval artifacts — regenerate via `python -m eval.component_metrics`
# and `python -m eval.end_to_end`.
eval/results/*.json
eval/results/*.png

# Playwright MCP traces
.playwright-mcp/

# Root-level dev screenshots (not docs)
/*.png
